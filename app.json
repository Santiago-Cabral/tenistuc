{
  "expo": {
    "name": "TenisTuc",
    "slug": "tenistuc",
    "scheme": "tenistuc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./logoverde.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tenistuc.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./logoverde.png",
        "backgroundColor": "#F8FAF9"
      },
      "package": "com.tenistuc.app",
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "TenisTuc necesita acceder a tus fotos para elegir tu foto de perfil.",
          "cameraPermission": "TenisTuc necesita la cámara para tomar tu foto de perfil."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./logoverde.png",
          "resizeMode": "contain",
          "backgroundColor": "#F8FAF9",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b157628b-225c-44e5-bafd-3832342cde9a"
      }
    },
    "owner": "scsoftwares-team"
  }
}